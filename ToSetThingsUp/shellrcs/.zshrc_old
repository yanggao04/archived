### Basic User Configurations
# terminal prompt

    # this is yet incomplete
    # python virtual env, however it comes to be
    if [ -z ${VIRTUAL_ENV+x} ] # if the variable is unset
    then
    VENV_NOTICE=""
    else
    VENV_NOTICE="(py:$(basename "$VIRTUAL_ENV"))"
    fi
    

export PS1="%F{red}%n%f@%F{green}%10>...>%M%<<%f %F{blue}%20<...<%~%<<%f %F{cyan}>%f "

# autocompletion
autoload -U compinit
compinit
# Default editor vim
export EDITOR="vim"

# homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# fuzzy search fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ----------

# alias to pip3 venv, which includes modules
 alias pipv="/Users/yanggao/python3venv/bin/pip"
 alias sourcePyVenv="source /Users/yanggao/python3venv/bin/activate"

# export PATH="/usr/local/anaconda3/bin:$PATH"  # commented out by conda initialize

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# Setting aliases for Sublime Text
alias subl="open -a Sublime\ Text"
alias SublimeText="Sublime\ Text"

# Setting alias for Typora
alias ty="open -a typora"

